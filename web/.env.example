# ── Copy to .env.local for local dev, and set these in Netlify → Site settings → Environment variables ──

# Canonical site URL — used for metadata, OpenGraph, sitemap, and JSON-LD.
# On Netlify this is your site URL, e.g. https://perala-srinivasulu.netlify.app
NEXT_PUBLIC_SITE_URL=https://perala-srinivasulu.netlify.app

# Formspree form ID for the contact form — create a free form at https://formspree.io
# and paste the ID (the part after /f/, e.g. "xpzgabcd").
# If left empty, the contact form falls back to opening the visitor's email client.
NEXT_PUBLIC_FORMSPREE_ID=

# Optional / legacy: webhook for the unused /api/contact route (Discord/Slack/etc.).
# The contact form now uses Formspree, so this is not required.
# CONTACT_WEBHOOK_URL=
